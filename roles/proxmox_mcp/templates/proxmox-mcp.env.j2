# {{ ansible_managed }}
# Rendered by the proxmox_mcp role. Secret material originates from Vault at
# {{ proxmox_mcp_vault_mount }}/{{ proxmox_mcp_vault_path }}. Do not edit by hand.

PROXMOX_HOST={{ proxmox_mcp_proxmox_host }}
PROXMOX_PORT={{ proxmox_mcp_proxmox_port }}
PROXMOX_USER={{ proxmox_mcp_vault_secret.secret.user }}
PROXMOX_TOKEN_NAME={{ proxmox_mcp_vault_secret.secret.token_name }}
PROXMOX_TOKEN_VALUE={{ proxmox_mcp_vault_secret.secret.token_secret }}
PROXMOX_VERIFY_TLS={{ 'true' if proxmox_mcp_verify_tls | bool else 'false' }}
PROXMOX_ALLOW_ELEVATED={{ 'true' if proxmox_mcp_allow_elevated | bool else 'false' }}
PROXMOX_NODE_ALLOWLIST={{ proxmox_mcp_node_allowlist | join(',') }}
PROXMOX_VMID_ALLOWLIST={{ proxmox_mcp_vmid_allowlist | join(',') }}
