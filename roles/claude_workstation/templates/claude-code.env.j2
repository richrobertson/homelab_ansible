# {{ ansible_managed }}
# Secret material originates from Vault at
# {{ claude_workstation_vault_mount }}/{{ claude_workstation_vault_api_path }}.
# Root-owned, mode 0640, group {{ claude_workstation_env_group }}. Do not edit
# by hand and do not copy into a home directory: /home is on a separate volume
# with a different backup and retention story.
ANTHROPIC_API_KEY={{ claude_workstation_api_secret.secret[claude_workstation_vault_api_key_field] }}
