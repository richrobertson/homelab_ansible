#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Publishes Vault secret rotation age as node_exporter textfile metrics.
#
# The estate's static credentials live in the secret/ KV mount and nothing
# expires them. Secrets that carry no rotation marker at all are the important
# case, not an edge case: they are indistinguishable from freshly rotated ones
# until something publishes their absence. credential_vault_secret_rotation_
# metadata_present is that measurement. See
# runbooks/security/credential-lifecycle-roadmap.md, Workstream 2.
#
# Rotation age is read from custom_metadata first (rotated_at /
# password_rotated_at / rotation_interval_days) because custom_metadata can be
# read without read access to the secret value itself. A short allow-list of
# paths that still carry the date as a data field is read directly; that list
# should shrink to nothing as the convention migrates to custom_metadata, and
# the Vault policy shrinks with it.
#
# On failure this leaves the previous .prom untouched rather than publishing
# zeros, since a zero rotation age reads as "everything is current".

set -euo pipefail

TEXTFILE_DIR="{{ credential_age_metrics_textfile_dir }}"
OUT="${TEXTFILE_DIR}/credential_age_vault.prom"
LOCK="{{ credential_age_vault_lock_file }}"
NODE="$(hostname -s)"

export VAULT_ADDR="{{ credential_age_vault_addr }}"
# Installed by ansible/proxmox/provision_certificates.yml; the collector carries
# a bind credential, so it verifies the Vault endpoint rather than skipping TLS.
export VAULT_CACERT="{{ credential_age_vault_ca_file }}"
MOUNT="{{ credential_age_vault_mount }}"
DEFAULT_INTERVAL_DAYS="{{ credential_age_vault_default_rotation_interval_days }}"
ROLE_ID_FILE="{{ credential_age_role_id_file }}"
SECRET_ID_FILE="{{ credential_age_secret_id_file }}"

# Paths whose rotation date is still a data field rather than custom_metadata.
DATA_FIELD_PATHS=(
{% for path in credential_age_vault_data_field_paths %}
  "{{ path }}"
{% endfor %}
)

TMP=""

cleanup() {
  [ -n "$TMP" ] && rm -f "$TMP"
  [ -n "${VAULT_TOKEN:-}" ] && vault token revoke -self >/dev/null 2>&1
  return 0
}
trap cleanup EXIT

# See credential-age-ad-metrics.sh for why flock is paired with pmxcfs leader
# election: /run/lock is node-local, so flock cannot exclude across the cluster,
# and a node that stops being the leader must withdraw its file rather than
# leave a frozen copy to be scraped.
leader="$(jq -r '
  [.nodelist | to_entries[] | select(.value.online == 1)]
  | sort_by(.value.id) | .[0].key // empty
' /etc/pve/.members 2>/dev/null || true)"
[ -n "$leader" ] || leader="$NODE"

if [ "$leader" != "$NODE" ]; then
  rm -f "$OUT"
  exit 0
fi

exec {lockfd}>"$LOCK"
if ! flock -n "$lockfd"; then
  exit 0
fi

if ! VAULT_TOKEN="$(vault write -field=token auth/approle/login \
  role_id=@"$ROLE_ID_FILE" secret_id=@"$SECRET_ID_FILE" 2>/dev/null)"; then
  echo "AppRole login to ${VAULT_ADDR} failed; leaving ${OUT} untouched" >&2
  exit 1
fi
export VAULT_TOKEN

escape_label() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# Accepts YYYY-MM-DD and RFC3339. Anything else is treated as no marker at all,
# because a date nothing can parse provides no more visibility than no date.
to_epoch() {
  local value="$1"
  [[ "$value" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2} ]] || return 1
  # Vault stamps updated_time with nanosecond precision, which not every
  # coreutils build will parse.
  value="$(sed -E 's/\.[0-9]+//' <<<"$value")"
  date -u -d "$value" +%s 2>/dev/null
}

walk() {
  local prefix="$1" key
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    if [[ "$key" == */ ]]; then
      walk "${prefix}${key}"
    else
      printf '%s\n' "${prefix}${key}"
    fi
  done < <(vault kv list -format=json "${MOUNT}/${prefix}" 2>/dev/null | jq -r '.[]? // empty')
}

if ! paths="$(walk '')"; then
  echo "could not list ${MOUNT}/; leaving ${OUT} untouched" >&2
  exit 1
fi

if [ -z "$paths" ]; then
  echo "${MOUNT}/ listed no secrets; leaving ${OUT} untouched" >&2
  exit 1
fi

TMP="$(mktemp "${OUT}.XXXXXX")"

{
  echo "# HELP credential_vault_secret_rotation_metadata_present Whether the secret declares a rotation date that this collector can read."
  echo "# TYPE credential_vault_secret_rotation_metadata_present gauge"
  echo "# HELP credential_vault_secret_rotated_timestamp_seconds Unix timestamp of the declared rotated_at for each secret."
  echo "# TYPE credential_vault_secret_rotated_timestamp_seconds gauge"
  echo "# HELP credential_vault_secret_rotation_interval_days Declared rotation interval for each secret, defaulted where unset."
  echo "# TYPE credential_vault_secret_rotation_interval_days gauge"
  echo "# HELP credential_vault_secret_last_write_timestamp_seconds Unix timestamp of the newest KV version, an upper bound on freshness when no rotation marker exists."
  echo "# TYPE credential_vault_secret_last_write_timestamp_seconds gauge"
  echo "# HELP credential_vault_secrets_total Number of secrets in the KV mount."
  echo "# TYPE credential_vault_secrets_total gauge"
  echo "# HELP credential_vault_secrets_without_rotation_metadata Number of secrets carrying no readable rotation date."
  echo "# TYPE credential_vault_secrets_without_rotation_metadata gauge"
  echo "# HELP credential_vault_collector_success Whether every secret in the last collection was read cleanly."
  echo "# TYPE credential_vault_collector_success gauge"
  echo "# HELP credential_vault_collector_last_run_timestamp_seconds Unix timestamp of the last completed Vault collection."
  echo "# TYPE credential_vault_collector_last_run_timestamp_seconds gauge"
} >"$TMP"

total=0
missing=0
unreadable=0
soft_failures=0

while IFS= read -r path; do
  [ -n "$path" ] || continue
  total=$((total + 1))
  esc_path="$(escape_label "$path")"

  # A path whose metadata cannot be read is not "has no rotation date", it is
  # unknown. Counting it either way would corrupt the aggregate below, so the
  # whole run is abandoned instead.
  if ! metadata="$(vault kv metadata get -format=json "${MOUNT}/${path}" 2>/dev/null)"; then
    unreadable=$((unreadable + 1))
    continue
  fi

  updated_time="$(jq -r '.data.updated_time // empty' <<<"$metadata")"
  if [ -n "$updated_time" ] && last_write="$(to_epoch "$updated_time")"; then
    echo "credential_vault_secret_last_write_timestamp_seconds{path=\"${esc_path}\"} ${last_write}" >>"$TMP"
  else
    soft_failures=$((soft_failures + 1))
  fi

  rotated_at="$(jq -r '
    .data.custom_metadata // {}
    | .rotated_at // .password_rotated_at // empty
  ' <<<"$metadata")"
  interval_days="$(jq -r '.data.custom_metadata.rotation_interval_days // empty' <<<"$metadata")"

  # Fall back to the data-field convention only for the allow-listed paths, so
  # the collector's Vault policy does not need read access to every secret
  # value in the estate just to learn a date.
  if [ -z "$rotated_at" ]; then
    for allowed in "${DATA_FIELD_PATHS[@]}"; do
      [ "$allowed" = "$path" ] || continue
      if secret_json="$(vault kv get -format=json "${MOUNT}/${path}" 2>/dev/null)"; then
        rotated_at="$(jq -r '.data.data | .rotated_at // .password_rotated_at // empty' <<<"$secret_json")"
        [ -n "$interval_days" ] || interval_days="$(jq -r '.data.data.rotation_interval_days // empty' <<<"$secret_json")"
      else
        soft_failures=$((soft_failures + 1))
      fi
      unset secret_json
      break
    done
  fi

  if [ -n "$rotated_at" ] && rotated_epoch="$(to_epoch "$rotated_at")"; then
    echo "credential_vault_secret_rotation_metadata_present{path=\"${esc_path}\"} 1" >>"$TMP"
    echo "credential_vault_secret_rotated_timestamp_seconds{path=\"${esc_path}\"} ${rotated_epoch}" >>"$TMP"
    [[ "$interval_days" =~ ^[0-9]+$ ]] || interval_days="$DEFAULT_INTERVAL_DAYS"
    echo "credential_vault_secret_rotation_interval_days{path=\"${esc_path}\"} ${interval_days}" >>"$TMP"
  else
    echo "credential_vault_secret_rotation_metadata_present{path=\"${esc_path}\"} 0" >>"$TMP"
    missing=$((missing + 1))
  fi
done <<<"$paths"

if [ "$unreadable" -gt 0 ]; then
  echo "${unreadable} of ${total} secrets in ${MOUNT}/ could not be read; leaving ${OUT} untouched" >&2
  exit 1
fi

echo "credential_vault_secrets_total ${total}" >>"$TMP"
echo "credential_vault_secrets_without_rotation_metadata ${missing}" >>"$TMP"

if [ "$soft_failures" -eq 0 ]; then
  echo "credential_vault_collector_success 1" >>"$TMP"
else
  echo "credential_vault_collector_success 0" >>"$TMP"
fi

echo "credential_vault_collector_last_run_timestamp_seconds $(date +%s)" >>"$TMP"

chmod 0644 "$TMP"
mv "$TMP" "$OUT"
TMP=""
