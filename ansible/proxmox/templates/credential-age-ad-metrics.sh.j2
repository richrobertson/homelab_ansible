#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Publishes Active Directory password age as node_exporter textfile metrics.
#
# Nothing in this estate measured credential age before this collector, which is
# how the `ldap` Domain Admin reached 2,052 days without anything noticing. The
# domain maxPwdAge of 42 days is bypassed in practice by DONT_EXPIRE_PASSWORD,
# so the flag is exported alongside the age rather than assumed absent. See
# runbooks/security/credential-lifecycle-roadmap.md, Workstream 2.
#
# Runs on every Proxmox node because that is where node_exporter and its
# textfile directory already are, but only one node collects per interval: three
# nodes publishing the same per-account series would multiply every alert by
# three and put three copies of the directory bind credential in flight.
#
# On failure this leaves the previous .prom untouched rather than publishing
# zeros, because a zero password age reads identically to "just rotated". A
# collector that has stopped entirely is detected from
# credential_ad_collector_last_run_timestamp_seconds going stale, not from a
# success metric that can no longer be written.

set -euo pipefail

TEXTFILE_DIR="{{ credential_age_metrics_textfile_dir }}"
OUT="${TEXTFILE_DIR}/credential_age_ad.prom"
LOCK="{{ credential_age_ad_lock_file }}"
NODE="$(hostname -s)"

BASE_DN="{{ credential_age_ad_base_dn }}"
LDAP_URI="{{ credential_age_ad_ldap_uri }}"
PRIVILEGED_GROUPS="{{ credential_age_ad_privileged_groups | join('|') }}"

export VAULT_ADDR="{{ credential_age_vault_addr }}"
# Installed by ansible/proxmox/provision_certificates.yml; the collector carries
# a bind credential, so it verifies the Vault endpoint rather than skipping TLS.
export VAULT_CACERT="{{ credential_age_vault_ca_file }}"
BIND_SECRET="{{ credential_age_vault_mount }}/{{ credential_age_ad_bind_secret_path }}"
ROLE_ID_FILE="{{ credential_age_role_id_file }}"
SECRET_ID_FILE="{{ credential_age_secret_id_file }}"

# The DC LDAPS certificates are issued by the AD CS root, so the bind can and
# should be verified rather than trusted blind: an unverified LDAPS bind hands
# the directory credential to anything that can answer on port 636.
export LDAPTLS_CACERT="{{ credential_age_ad_ca_file }}"
export LDAPTLS_REQCERT="{{ 'demand' if credential_age_ad_tls_verify | bool else 'never' }}"

TMP=""
PWFILE=""

cleanup() {
  [ -n "$PWFILE" ] && shred -u "$PWFILE" >/dev/null 2>&1
  [ -n "$TMP" ] && rm -f "$TMP"
  [ -n "${VAULT_TOKEN:-}" ] && vault token revoke -self >/dev/null 2>&1
  return 0
}
trap cleanup EXIT

# /run/lock is tmpfs, so flock alone only serialises runs on this node. Single
# collection across the cluster needs pmxcfs: elect the online node with the
# lowest Corosync id, and have every other node withdraw its file. Without the
# withdrawal a leadership change would leave a frozen .prom being scraped
# forever, which is the exact failure this collector exists to detect.
leader="$(jq -r '
  [.nodelist | to_entries[] | select(.value.online == 1)]
  | sort_by(.value.id) | .[0].key // empty
' /etc/pve/.members 2>/dev/null || true)"
[ -n "$leader" ] || leader="$NODE"

if [ "$leader" != "$NODE" ]; then
  rm -f "$OUT"
  exit 0
fi

exec {lockfd}>"$LOCK"
if ! flock -n "$lockfd"; then
  exit 0
fi

if ! VAULT_TOKEN="$(vault write -field=token auth/approle/login \
  role_id=@"$ROLE_ID_FILE" secret_id=@"$SECRET_ID_FILE" 2>/dev/null)"; then
  echo "AppRole login to ${VAULT_ADDR} failed; leaving ${OUT} untouched" >&2
  exit 1
fi
export VAULT_TOKEN

if ! bind_dn="$(vault kv get -field=username "$BIND_SECRET" 2>/dev/null)"; then
  echo "could not read the bind username from ${BIND_SECRET}" >&2
  exit 1
fi

# ldapsearch -w would put the password in argv and therefore in /proc for every
# local user, so it goes through a 0600 file on tmpfs that is shredded on exit.
PWFILE="$(mktemp /run/credential-age-ad.XXXXXX)"
if ! vault kv get -field=password "$BIND_SECRET" 2>/dev/null | tr -d '\n' >"$PWFILE"; then
  echo "could not read the bind password from ${BIND_SECRET}" >&2
  exit 1
fi

ldap_search() {
  local scope="$1" filter="$2"
  shift 2
  ldapsearch -LLL -o ldif-wrap=no -x -H "$LDAP_URI" \
    -D "$bind_dn" -y "$PWFILE" -b "$BASE_DN" -s "$scope" "$filter" "$@" 2>/dev/null
}

if ! accounts_ldif="$(ldap_search sub '(&(objectCategory=person)(objectClass=user))' \
  sAMAccountName pwdLastSet userAccountControl adminCount memberOf)"; then
  echo "account search against ${LDAP_URI} failed" >&2
  exit 1
fi

# Domain policy is the yardstick the age metrics are compared against, so a
# partial result here degrades the alerts rather than the collector.
policy_ldif="$(ldap_search base '(objectClass=*)' maxPwdAge minPwdLength lockoutThreshold || true)"

escape_label() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

ldif_value() {
  awk -v attr="$1" '
    tolower($1) == (tolower(attr) ":") { print $2; exit }
  ' <<<"$policy_ldif"
}

# AD stores pwdLastSet and maxPwdAge as 100ns intervals since 1601-01-01.
filetime_to_unix() {
  echo $(( $1 / 10000000 - 11644473600 ))
}

TMP="$(mktemp "${OUT}.XXXXXX")"

{
  echo "# HELP credential_ad_password_last_set_timestamp_seconds Unix timestamp at which each Active Directory account last had its password set."
  echo "# TYPE credential_ad_password_last_set_timestamp_seconds gauge"
  echo "# HELP credential_ad_password_never_set Whether the account has pwdLastSet=0 and therefore no password age at all."
  echo "# TYPE credential_ad_password_never_set gauge"
  echo "# HELP credential_ad_account_admin_count Whether adminCount=1, meaning the account is or has been protected by AdminSDHolder."
  echo "# TYPE credential_ad_account_admin_count gauge"
  echo "# HELP credential_ad_account_privileged_group Direct membership of a privileged Active Directory group."
  echo "# TYPE credential_ad_account_privileged_group gauge"
  echo "# HELP credential_ad_krbtgt_password_last_set_timestamp_seconds Unix timestamp at which each krbtgt key was last rotated."
  echo "# TYPE credential_ad_krbtgt_password_last_set_timestamp_seconds gauge"
  echo "# HELP credential_ad_domain_max_password_age_seconds Domain maxPwdAge in seconds, or 0 when passwords never expire."
  echo "# TYPE credential_ad_domain_max_password_age_seconds gauge"
  echo "# HELP credential_ad_domain_min_password_length Domain minPwdLength."
  echo "# TYPE credential_ad_domain_min_password_length gauge"
  echo "# HELP credential_ad_domain_lockout_threshold Domain lockoutThreshold, where 0 means failed passwords are never locked out."
  echo "# TYPE credential_ad_domain_lockout_threshold gauge"
  echo "# HELP credential_ad_accounts_total Number of Active Directory accounts inspected."
  echo "# TYPE credential_ad_accounts_total gauge"
  echo "# HELP credential_ad_collector_success Whether every account in the last collection parsed cleanly."
  echo "# TYPE credential_ad_collector_success gauge"
  echo "# HELP credential_ad_collector_last_run_timestamp_seconds Unix timestamp of the last completed Active Directory collection."
  echo "# TYPE credential_ad_collector_last_run_timestamp_seconds gauge"
} >"$TMP"

# LDIF base64-encodes any value that is not plain ASCII, so the parse is done in
# Python rather than awk: a memberOf left undecoded would silently drop an
# account out of the privileged set, which is the one mistake that would make
# this collector under-report rather than over-report.
parsed="$(python3 -c '
import base64, sys

privileged = {g.strip().lower() for g in sys.argv[1].split("|") if g.strip()}
entries, current = [], {}

def add(entry, attr, raw, encoded):
    value = base64.b64decode(raw).decode("utf-8", "replace") if encoded else raw
    entry.setdefault(attr.lower(), []).append(value)

for line in sys.stdin.read().splitlines():
    if not line.strip():
        if current:
            entries.append(current)
            current = {}
        continue
    if ":" not in line:
        continue
    attr, _, rest = line.partition(":")
    encoded = rest.startswith(":")
    add(current, attr, rest.lstrip(":").strip(), encoded)

if current:
    entries.append(current)

for entry in entries:
    names = entry.get("samaccountname")
    if not names:
        continue
    account = names[0]
    try:
        pwd_last_set = int(entry.get("pwdlastset", ["0"])[0])
        uac = int(entry.get("useraccountcontrol", ["0"])[0])
    except ValueError:
        print("\t".join([account, "invalid", "0", "0", "0", ""]))
        continue
    admin_count = 1 if entry.get("admincount", ["0"])[0] == "1" else 0
    # memberOf is not transitive, so this catches direct membership only. That
    # is enough for the accounts that matter here and avoids a recursive search
    # against the DC on every scrape interval.
    groups = []
    for dn in entry.get("memberof", []):
        rdn = dn.split(",", 1)[0]
        name = rdn.split("=", 1)[1] if "=" in rdn else rdn
        if name.strip().lower() in privileged:
            groups.append(name.strip())
    # adminCount alone misses netsvc, which is privileged only through
    # DnsAdmins, so both signals feed the privileged label.
    privileged_flag = 1 if admin_count or groups else 0
    print("\t".join([
        account, str(pwd_last_set), str(uac), str(admin_count),
        str(privileged_flag), ",".join(sorted(groups)),
    ]))
' "$PRIVILEGED_GROUPS" <<<"$accounts_ldif")"

accounts=0
failures=0

while IFS=$'\t' read -r account pwd_last_set uac admin_count privileged groups; do
  [ -n "$account" ] || continue
  accounts=$((accounts + 1))
  esc_account="$(escape_label "$account")"

  if [ "$pwd_last_set" = "invalid" ]; then
    failures=$((failures + 1))
    continue
  fi

  # userAccountControl bits: 0x2 ACCOUNTDISABLE, 0x10000 DONT_EXPIRE_PASSWORD.
  (( uac & 0x2 )) && enabled="false" || enabled="true"
  (( uac & 0x10000 )) && never_expires="true" || never_expires="false"
  [ "$privileged" = "1" ] && privileged_label="true" || privileged_label="false"

  labels="account=\"${esc_account}\",enabled=\"${enabled}\""
  labels="${labels},never_expires=\"${never_expires}\",privileged=\"${privileged_label}\""

  # never_set carries the SAME ${labels} as the timestamp series, deliberately.
  # It used to be emitted with only account=, which left it as the one
  # credential metric that could not be filtered on enabled state - so
  # ADAccountPasswordNeverSet fired forever on Guest, an account that is
  # disabled, has never logged on, and has no password to age. Meanwhile the two
  # age alerts next to it both select {enabled="true"} and correctly ignored it.
  # That asymmetry is what made a disabled account look like an open finding.
  #
  # Emitting the full label set lets the rule apply the same filter as its
  # neighbours. Note the label must exist BEFORE the rule filters on it:
  # selecting {enabled="true"} against a metric that never carried the label
  # matches nothing, which silences the alert for the wrong reason and would
  # hide a genuinely enabled account with no password set.
  if [ "$pwd_last_set" -gt 0 ]; then
    echo "credential_ad_password_last_set_timestamp_seconds{${labels}} $(filetime_to_unix "$pwd_last_set")" >>"$TMP"
    echo "credential_ad_password_never_set{${labels}} 0" >>"$TMP"
  else
    # No timestamp series at all, so an age query cannot silently read this
    # account as freshly rotated.
    echo "credential_ad_password_never_set{${labels}} 1" >>"$TMP"
  fi

  echo "credential_ad_account_admin_count{account=\"${esc_account}\"} ${admin_count}" >>"$TMP"

  if [ -n "$groups" ]; then
    while IFS= read -r group; do
      [ -n "$group" ] || continue
      echo "credential_ad_account_privileged_group{account=\"${esc_account}\",group=\"$(escape_label "$group")\"} 1" >>"$TMP"
    done < <(tr ',' '\n' <<<"$groups")
  fi

  # krbtgt gets its own series because its rotation interval has nothing to do
  # with the user password policy, and RODC keys (krbtgt_NNNNN) rotate with it.
  case "$account" in
    krbtgt|krbtgt_*)
      if [ "$pwd_last_set" -gt 0 ]; then
        echo "credential_ad_krbtgt_password_last_set_timestamp_seconds{account=\"${esc_account}\"} $(filetime_to_unix "$pwd_last_set")" >>"$TMP"
      fi
      ;;
  esac
done <<<"$parsed"

max_pwd_age_raw="$(ldif_value maxPwdAge)"
min_pwd_length="$(ldif_value minPwdLength)"
lockout_threshold="$(ldif_value lockoutThreshold)"

# maxPwdAge is stored negative. The int64 minimum is the "never expires"
# sentinel, published as 0 so alerts can guard on a positive interval.
if [[ "$max_pwd_age_raw" =~ ^-[0-9]+$ ]] && [ "$max_pwd_age_raw" != "-9223372036854775808" ]; then
  echo "credential_ad_domain_max_password_age_seconds $(( -max_pwd_age_raw / 10000000 ))" >>"$TMP"
else
  echo "credential_ad_domain_max_password_age_seconds 0" >>"$TMP"
  [ -n "$max_pwd_age_raw" ] || failures=$((failures + 1))
fi

if [[ "$min_pwd_length" =~ ^[0-9]+$ ]]; then
  echo "credential_ad_domain_min_password_length ${min_pwd_length}" >>"$TMP"
else
  failures=$((failures + 1))
fi

if [[ "$lockout_threshold" =~ ^[0-9]+$ ]]; then
  echo "credential_ad_domain_lockout_threshold ${lockout_threshold}" >>"$TMP"
else
  failures=$((failures + 1))
fi

if [ "$accounts" -eq 0 ]; then
  echo "the account search returned no accounts; leaving ${OUT} untouched" >&2
  exit 1
fi

echo "credential_ad_accounts_total ${accounts}" >>"$TMP"

if [ "$failures" -eq 0 ]; then
  echo "credential_ad_collector_success 1" >>"$TMP"
else
  echo "credential_ad_collector_success 0" >>"$TMP"
fi

echo "credential_ad_collector_last_run_timestamp_seconds $(date +%s)" >>"$TMP"

chmod 0644 "$TMP"
mv "$TMP" "$OUT"
TMP=""
