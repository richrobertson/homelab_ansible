# {{ ansible_managed }}
[Unit]
Description=Daily due-check for the PBS root password rotation
Documentation=file://{{ pbs_root_password_rotation_script }}

[Timer]
# Daily: rotates once the recorded age reaches
# {{ pbs_root_password_rotation_rotate_after_days }} days, well inside the
# {{ pbs_root_password_rotation_interval_days }}-day alert threshold.
OnCalendar={{ pbs_root_password_rotation_on_calendar }}
RandomizedDelaySec={{ pbs_root_password_rotation_randomized_delay }}
Persistent=true
Unit={{ pbs_root_password_rotation_unit_name }}.service

[Install]
WantedBy=timers.target
