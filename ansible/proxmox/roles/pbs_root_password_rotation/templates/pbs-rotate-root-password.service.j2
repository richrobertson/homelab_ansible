# {{ ansible_managed }}
[Unit]
Description=Rotate the PBS root password and record it in Vault
Documentation=file://{{ pbs_root_password_rotation_script }}
After=network-online.target proxmox-backup-proxy.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ pbs_root_password_rotation_script }}
TimeoutStartSec=600
User=root
Group=root

[Install]
WantedBy=multi-user.target
