#!/usr/bin/env python3
# {{ ansible_managed }}
"""Rotate this PBS host's root password and record it in Vault.

Order of operations, and why:
  1. Prove Vault's current value logs in to the PBS API as root@pam. If it does
     not, Vault and the host already disagree - refuse rather than make it worse.
  2. Set the new password (chpasswd, via stdin).
  3. Prove the new password logs in and the old one is refused.
  4. Log in to Vault AGAIN (the AppRole token is short-lived; a 2026-11-17 PBS
     B2 run lost its token mid-run) and patch only the password key.
  5. Read Vault back and compare.
Any failure after step 2 restores the old password and proves it works, so the
host and Vault always end up agreeing. Secrets travel on stdin only.

  --check   validate the whole path (AppRole login, record, current password
            logs in); change nothing
  --force   rotate regardless of the recorded age
"""

import argparse
import datetime
import fcntl
import hashlib
import json
import os
import secrets
import signal
import ssl
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

VAULT_ADDR = "{{ pbs_root_password_rotation_vault_addr }}"
VAULT_CA = "{{ pbs_root_password_rotation_vault_ca_file }}"
KV_MOUNT = "{{ pbs_root_password_rotation_kv_mount }}"
KV_PATH = "{{ pbs_root_password_rotation_kv_path }}"
KV_KEY = "{{ pbs_root_password_rotation_kv_key }}"
ROLE_ID_FILE = "{{ pbs_root_password_rotation_role_id_file }}"
SECRET_ID_FILE = "{{ pbs_root_password_rotation_secret_id_file }}"
INTERVAL_DAYS = {{ pbs_root_password_rotation_interval_days | int }}
ROTATE_AFTER_DAYS = {{ pbs_root_password_rotation_rotate_after_days | int }}
STATE_DIR = "{{ pbs_root_password_rotation_state_dir }}"
LOCK_FILE = os.path.join(STATE_DIR, "rotation.lock")
PBS_TICKET_URL = "https://127.0.0.1:8007/api2/json/access/ticket"


def log(msg):
    print("%s %s" % (datetime.datetime.now().strftime("%H:%M:%S"), msg), flush=True)


def run(args, timeout=120, env=None, stdin_data=None):
    proc = subprocess.run(
        args,
        input=stdin_data.encode() if stdin_data is not None else None,
        capture_output=True, timeout=timeout, env=env,
    )
    return (proc.returncode, proc.stdout.decode("utf-8", "replace").strip(),
            proc.stderr.decode("utf-8", "replace").strip())


def h(value):
    return hashlib.sha256(value.encode()).hexdigest()[:12]


# --- Vault (CLI, token via env, payloads via stdin) --------------------------

def vault_env(token=None):
    env = dict(os.environ)
    env["VAULT_ADDR"] = VAULT_ADDR
    env["VAULT_CACERT"] = VAULT_CA
    env.pop("VAULT_TOKEN", None)
    if token:
        env["VAULT_TOKEN"] = token
    return env


def vault_login():
    with open(ROLE_ID_FILE) as fh:
        role_id = fh.read().strip()
    with open(SECRET_ID_FILE) as fh:
        secret_id = fh.read().strip()
    rc, out, err = run(["vault", "write", "-format=json", "auth/approle/login", "-"],
                       env=vault_env(), stdin_data=json.dumps({"role_id": role_id, "secret_id": secret_id}))
    if rc != 0:
        raise RuntimeError("vault approle login failed: %s" % (err or out))
    return json.loads(out)["auth"]["client_token"]


def vault_record(token):
    rc, out, err = run(["vault", "kv", "get", "-format=json", "-mount=%s" % KV_MOUNT, KV_PATH], env=vault_env(token))
    if rc != 0:
        raise RuntimeError("vault read failed: %s" % (err or out))
    data = json.loads(out)["data"]
    return data["data"], (data.get("metadata") or {})


def vault_rotated_at(token):
    rc, out, _err = run(["vault", "kv", "metadata", "get", "-format=json", "-mount=%s" % KV_MOUNT, KV_PATH],
                        env=vault_env(token))
    if rc != 0:
        return None
    raw = (json.loads(out)["data"].get("custom_metadata") or {}).get("rotated_at")
    try:
        return datetime.date.fromisoformat(raw[:10]) if raw else None
    except ValueError:
        return None


def vault_patch(token, data):
    rc, out, err = run(["vault", "kv", "patch", "-format=json", "-mount=%s" % KV_MOUNT, KV_PATH, "-"],
                       env=vault_env(token), stdin_data=json.dumps(data))
    if rc != 0:
        raise RuntimeError("vault kv patch failed: %s" % (err or out))


def vault_stamp(token):
    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    rc, out, err = run(["vault", "kv", "metadata", "patch", "-mount=%s" % KV_MOUNT,
                        "-custom-metadata=rotated_at=%s" % now,
                        "-custom-metadata=rotation_interval_days=%d" % INTERVAL_DAYS, KV_PATH],
                       env=vault_env(token))
    if rc != 0:
        raise RuntimeError("vault metadata patch failed: %s" % (err or out))
    return now


# --- PBS / host ---------------------------------------------------------------

def pbs_login_ok(password):
    """True iff root@pam authenticates against the local PBS API.

    TLS verification is off because this is 127.0.0.1 and the proxy's cert is
    issued to the hostname; nothing leaves the host.
    """
    body = urllib.parse.urlencode({"username": "root@pam", "password": password}).encode()
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    req = urllib.request.Request(PBS_TICKET_URL, data=body, method="POST")
    try:
        with urllib.request.urlopen(req, context=ctx, timeout=30) as resp:
            return resp.status == 200
    except urllib.error.HTTPError as exc:
        if exc.code in (401, 403):
            return False
        raise RuntimeError("PBS ticket endpoint returned HTTP %d" % exc.code)


def set_root_password(password):
    rc, out, err = run(["chpasswd"], stdin_data="root:%s\n" % password)
    if rc != 0:
        raise RuntimeError("chpasswd failed: %s" % (err or out))


def wait_login(password, want, attempts=6):
    for _ in range(attempts):
        if pbs_login_ok(password) is want:
            return True
        time.sleep(5)
    return False


# --- rotation -------------------------------------------------------------

def rotate(args):
    token = vault_login()
    log("authenticated to Vault via AppRole")
    record, _meta = vault_record(token)
    old = record.get(KV_KEY) or ""
    if not old:
        raise RuntimeError("%s/%s has no %s" % (KV_MOUNT, KV_PATH, KV_KEY))
    if not pbs_login_ok(old):
        raise RuntimeError("Vault's root password does NOT log in to PBS - host and Vault already "
                           "disagree; refusing to rotate. Fix by hand first.")
    log("preflight: Vault's root password logs in (hash %s)" % h(old))

    rotated = vault_rotated_at(token)
    age = (datetime.date.today() - rotated).days if rotated else None
    log("recorded age: %s day(s)" % ("unknown" if age is None else age))
    if args.check:
        log("check OK: nothing changed")
        return 0
    if not args.force and age is not None and age < ROTATE_AFTER_DAYS:
        log("not due (%d < %d days)" % (age, ROTATE_AFTER_DAYS))
        return 0

    new = secrets.token_urlsafe(33)
    set_root_password(new)
    log("set new root password (hash %s)" % h(new))
    try:
        if not wait_login(new, True):
            raise RuntimeError("new password does not log in to PBS")
        if not wait_login(old, False):
            raise RuntimeError("old password still logs in after the change")
        log("verified: new password logs in, old one is refused")
        token = vault_login()
        vault_patch(token, {KV_KEY: new})
        stored, _ = vault_record(token)
        if stored.get(KV_KEY) != new:
            raise RuntimeError("Vault read-back does not match the new password")
        stamp = vault_stamp(token)
        log("recorded in Vault %s/%s, rotated_at=%s" % (KV_MOUNT, KV_PATH, stamp))
    except Exception as exc:
        log("ERROR after the change: %s - restoring the old password" % exc)
        set_root_password(old)
        if wait_login(old, True):
            log("restored: old password logs in again; Vault still holds it")
        else:
            log("ROLLBACK FAILED: old password does not log in. Vault holds hash %s, "
                "the attempted new one was %s. Fix root's password at the console." % (h(old), h(new)))
        # Vault may have been patched before the failure (e.g. stamp failed):
        # put the old value back so it matches the host again.
        try:
            token = vault_login()
            stored, _ = vault_record(token)
            if stored.get(KV_KEY) != old:
                vault_patch(token, {KV_KEY: old})
                log("Vault reset to the old password")
        except Exception as exc2:  # noqa: BLE001 - report, never mask the original
            log("could not re-check Vault after rollback: %s" % exc2)
        raise
    log("rotation complete")
    return 0


def _on_signal(signum, _frame):
    raise RuntimeError("interrupted by signal %d" % signum)


def main():
    signal.signal(signal.SIGTERM, _on_signal)
    signal.signal(signal.SIGINT, _on_signal)
    parser = argparse.ArgumentParser(description="Rotate the PBS root password.")
    parser.add_argument("--check", action="store_true", help="validate the path; change nothing")
    parser.add_argument("--force", action="store_true", help="rotate regardless of recorded age")
    args = parser.parse_args()
    os.makedirs(STATE_DIR, exist_ok=True)
    os.chmod(STATE_DIR, 0o750)
    with open(LOCK_FILE, "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            log("another rotation is already running; exiting")
            return 0
        try:
            return rotate(args)
        except Exception as exc:  # noqa: BLE001
            log("ERROR: %s" % exc)
            return 1


if __name__ == "__main__":
    sys.exit(main())
