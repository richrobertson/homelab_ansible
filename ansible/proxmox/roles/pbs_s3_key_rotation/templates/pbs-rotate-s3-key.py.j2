S3_REGION = "{{ pbs_s3_key_rotation_s3_region }}"
IAM_REGION = "{{ pbs_s3_key_rotation_iam_region }}"

VAULT_ADDR = "{{ pbs_s3_key_rotation_vault_addr }}"
VAULT_CA = "{{ pbs_s3_key_rotation_vault_ca_file }}"
VAULT_AWS_MOUNT = "{{ pbs_s3_key_rotation_vault_aws_mount }}"
VAULT_AWS_ROLE = "{{ pbs_s3_key_rotation_vault_aws_role }}"
KV_MOUNT = "{{ pbs_s3_key_rotation_vault_kv_mount }}"
KV_PATH = "{{ pbs_s3_key_rotation_vault_kv_path }}"
ROLE_ID_FILE = "{{ pbs_s3_key_rotation_role_id_file }}"
SECRET_ID_FILE = "{{ pbs_s3_key_rotation_secret_id_file }}"

INTERVAL_DAYS = {{ pbs_s3_key_rotation_interval_days | int }}
