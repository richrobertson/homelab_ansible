#!/usr/bin/env python3
# {{ ansible_managed }}
#
# Rotate the AWS access key behind the {{ pbs_s3_key_rotation_endpoint_id }} S3
# endpoint that the {{ pbs_s3_key_rotation_datastore }} datastore uses.
#
# The rotation is ordered so that every step before the final revoke is
# recoverable, because AWS allows two live access keys per user and the old one
# stays valid throughout:
#
#   1. preflight    - config matches IAM, no active tasks, s3 check already passes
#   2. mint         - CreateAccessKey (now two live keys)
#   3. prove        - the NEW key lists the bucket directly, retried past IAM's
#                     eventual consistency
#   4. swap         - back up s3.cfg, `s3 endpoint update`, re-assert 0640 root:backup
#   5. reload       - SIGHUP proxmox-backup-proxy so it re-reads the config
#   6. verify       - s3 check, the untouched-sibling assertion, journal scan
#   7. record       - write Vault + rotated_at metadata
#   8. revoke       - DeleteAccessKey on the old key, confirmed gone
#
# Any failure from step 4 onwards restores the backed-up config, reloads, and
# deletes the new key, leaving the host exactly as it was found. A failure at
# step 7 deliberately stops WITHOUT revoking: the new key is live and working, so
# the safe state is two live keys and a loud non-zero exit, not a silent loss of
# the record of which key is in use.
#
# No AWS SDK is installed on this host and this script does not add one, so IAM
# and S3 are called directly with a SigV4 signer. That is ~40 lines of stable,
# well-specified algorithm versus adding a package to a backup server.

import argparse
import datetime
import fcntl
import hashlib
import hmac
import json
import os
import pwd
import grp
import shutil
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET

