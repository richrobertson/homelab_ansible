#!/usr/bin/env python3
# {{ ansible_managed }}
#
# Re-verify PBS snapshots left at verify_state=failed by a transient object-store
# read error. See roles/pbs_verify_sweep/defaults/main.yml for the rationale.
#
# Exit codes:
#   0  nothing to do, or every eligible snapshot was re-verified clean
#   1  a snapshot is still failed after re-verification, or was skipped because
#      it exhausted its attempt budget / the datastore has corrupt chunks.
#      PBSSnapshotVerifyFailed is expected to still be firing in that case.
#   2  the sweep could not run (bad config, tooling missing)

import json
import os
import subprocess
import sys
import time
from datetime import datetime, timezone

DATASTORES = json.loads(r"""{{ pbs_verify_sweep_datastores | to_json }}""")
MAX_ATTEMPTS = {{ pbs_verify_sweep_max_attempts }}
MAX_PER_RUN = {{ pbs_verify_sweep_max_per_run }}
ABORT_ON_BAD_CHUNKS = {{ pbs_verify_sweep_abort_on_bad_chunks | bool | ternary('True', 'False') }}
VERIFY_TIMEOUT = {{ pbs_verify_sweep_timeout_seconds }}
STATE_DIR = "{{ pbs_verify_sweep_state_dir }}"
STATE_FILE = os.path.join(STATE_DIR, "attempts.json")

DEBUG_TOOL = "/usr/sbin/proxmox-backup-debug"
MANIFEST = "index.json.blob"
ACTIVE_TASKS = "/var/log/proxmox-backup/tasks/active"
MANIFEST_TIMEOUT = 30


def log(msg):
    print("%s %s" % (datetime.now(timezone.utc).isoformat(timespec="seconds"), msg), flush=True)


def load_state():
    try:
        with open(STATE_FILE) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def save_state(state):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(state, fh, indent=1, sort_keys=True)
    os.replace(tmp, STATE_FILE)


def verification_running():
    """True if any verify task is currently active.

    Re-verifying while the daily job is mid-flight would contend for the same
    object-store reads, so the sweep simply defers to the next run.
    """
    try:
        with open(ACTIVE_TASKS) as fh:
            body = fh.read()
    except OSError:
        return False
    return any(marker in body for marker in (":verificationjob:", ":verify_snapshot:", ":verify:"))


def bad_chunk_count(path):
    """Count quarantined chunks. Non-zero means real corruption, not transport."""
    chunks = os.path.join(path, ".chunks")
    count = 0
    for root, dirs, files in os.walk(chunks):
        for name in files:
            if ".bad" in name:
                count += 1
    return count


def manifest_verify_state(manifest_path):
    try:
        out = subprocess.run(
            [DEBUG_TOOL, "inspect", "file", manifest_path, "--decode", "-"],
            capture_output=True, check=True, timeout=MANIFEST_TIMEOUT,
        ).stdout
        manifest, _ = json.JSONDecoder().raw_decode(out.decode("utf-8", "replace"))
    except (subprocess.SubprocessError, OSError, ValueError):
        return None
    state = (manifest.get("unprotected") or {}).get("verify_state")
    if not isinstance(state, dict):
        return "none"
    return str(state.get("state") or "none")


def parse_snapshot(rel):
    """Split a snapshot path relative to the datastore root.

    Handles namespaced layouts: ns/<a>/ns/<b>/vm/112/<timestamp>.
    Returns (namespace, backup_type, backup_id, backup_time_epoch) or None.
    """
    parts = rel.split(os.sep)
    namespaces = []
    i = 0
    while i + 1 < len(parts) and parts[i] == "ns":
        namespaces.append(parts[i + 1])
        i += 2
    if len(parts) - i != 3:
        return None
    btype, bid, btime = parts[i], parts[i + 1], parts[i + 2]
    if btype not in ("vm", "ct", "host"):
        return None
    try:
        dt = datetime.strptime(btime, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except ValueError:
        return None
    return "/".join(namespaces), btype, bid, int(dt.timestamp())


def find_failed(path):
    """Yield (relpath, parsed) for every snapshot recorded as failed."""
    found = []
    for root, dirs, files in os.walk(path):
        dirs[:] = [d for d in dirs if not d.startswith(".")]
        if MANIFEST not in files:
            continue
        if manifest_verify_state(os.path.join(root, MANIFEST)) != "failed":
            continue
        rel = os.path.relpath(root, path)
        parsed = parse_snapshot(rel)
        if parsed is None:
            log("  WARN unparseable snapshot path, skipping: %s" % rel)
            continue
        found.append((rel, parsed))
    return found


def reverify(store, parsed):
    namespace, btype, bid, btime = parsed
    cmd = [
        DEBUG_TOOL, "api", "create", "/admin/datastore/%s/verify" % store,
        "--backup-type", btype, "--backup-id", bid,
        "--backup-time", str(btime), "--ignore-verified", "false",
    ]
    if namespace:
        cmd += ["--ns", namespace]
    started = time.monotonic()
    try:
        proc = subprocess.run(cmd, capture_output=True, timeout=VERIFY_TIMEOUT)
    except subprocess.TimeoutExpired:
        log("  TIMEOUT after %ds" % VERIFY_TIMEOUT)
        return False
    elapsed = int(time.monotonic() - started)
    if proc.returncode != 0:
        log("  verify call failed rc=%d in %ds: %s"
            % (proc.returncode, elapsed, proc.stderr.decode("utf-8", "replace").strip()[:300]))
        return False
    log("  verify call completed in %ds" % elapsed)
    return True


def main():
    if not os.path.exists(DEBUG_TOOL):
        log("FATAL %s not present" % DEBUG_TOOL)
        return 2

    if verification_running():
        log("a verification task is already active; deferring to the next run")
        return 0

    state = load_state()
    unresolved = False
    budget = MAX_PER_RUN

    for store in DATASTORES:
        name, path = store["name"], store["path"]
        if not os.path.isdir(path):
            log("%s: path %s missing, skipping" % (name, path))
            continue

        if ABORT_ON_BAD_CHUNKS:
            bad = bad_chunk_count(path)
            if bad:
                log("%s: %d quarantined .bad chunk(s) present -- real corruption, "
                    "not a transport blip. Refusing to auto-re-verify; investigate by hand."
                    % (name, bad))
                unresolved = True
                continue

        failed = find_failed(path)
        if not failed:
            log("%s: no snapshots recorded as failed" % name)
            continue
        log("%s: %d snapshot(s) recorded as failed" % (name, len(failed)))

        for rel, parsed in failed:
            key = "%s/%s" % (name, rel)
            attempts = state.get(key, {}).get("attempts", 0)
            if attempts >= MAX_ATTEMPTS:
                log("  %s: %d attempts already spent, leaving failed for a human" % (rel, attempts))
                unresolved = True
                continue
            if budget <= 0:
                log("  %s: per-run budget exhausted, deferring to the next run" % rel)
                unresolved = True
                continue

            budget -= 1
            log("  %s: re-verifying (attempt %d/%d)" % (rel, attempts + 1, MAX_ATTEMPTS))
            state[key] = {
                "attempts": attempts + 1,
                "last": datetime.now(timezone.utc).isoformat(timespec="seconds"),
            }
            save_state(state)

            reverify(name, parsed)

            # Trust the manifest, not the call's exit status: it is the value the
            # alert actually reads.
            now_state = manifest_verify_state(os.path.join(path, rel, MANIFEST))
            if now_state == "ok":
                log("  %s: now verifies OK -- clearing attempt history" % rel)
                state.pop(key, None)
                save_state(state)
            else:
                log("  %s: still '%s' after re-verification" % (rel, now_state))
                unresolved = True

    return 1 if unresolved else 0


if __name__ == "__main__":
    sys.exit(main())
