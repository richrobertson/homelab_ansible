# {{ ansible_managed }}
# Vault Agent instance that keeps the Ceph admin gateway certificate current.
# It reuses the AppRole created by ansible/proxmox/provision_certificates.yml.

pid_file = "{{ ceph_admin_gateway_agent_runtime_dir }}/agent.pid"

vault {
  address = "{{ ceph_admin_gateway_vault_addr }}"
  ca_cert = "{{ ceph_admin_gateway_vault_ca_file }}"
}

auto_auth {
  method "approle" {
    config = {
      role_id_file_path                   = "{{ ceph_admin_gateway_role_id_file }}"
      secret_id_file_path                 = "{{ ceph_admin_gateway_secret_id_file }}"
      remove_secret_id_file_after_reading = false
    }
  }

  sink "file" {
    config = {
      path = "{{ ceph_admin_gateway_agent_runtime_dir }}/token"
      mode = 0640
    }
  }
}

# HAProxy expects a single PEM containing the leaf, its chain, and the private
# key, in that order. pkiCert only re-issues as expiry approaches, so this does
# not mint a new certificate on every agent restart.
template {
  destination = "{{ ceph_admin_gateway_pem_file }}"
  perms       = "0600"
  command     = "/bin/systemctl reload haproxy"

  contents = <<-EOT
{% raw %}{{ with pkiCert "{% endraw %}{{ ceph_admin_gateway_pki_mount }}/issue/{{ ceph_admin_gateway_pki_role }}{% raw %}" "{% endraw %}common_name={{ ceph_admin_gateway_fqdn }}{% raw %}" "{% endraw %}alt_names={{ ceph_admin_gateway_extra_sans | join(',') }}{% raw %}" "{% endraw %}ip_sans={{ ceph_admin_gateway_vip }}{% raw %}" "{% endraw %}ttl={{ ceph_admin_gateway_cert_ttl }}{% raw %}" }}
{{ .Cert }}{{ .CA }}{{ .Key }}
{{ end }}{% endraw %}
EOT
}
