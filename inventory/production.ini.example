# Production Inventory Example
# Copy this file to environments/production.ini and customize for your environment
#
# Replace example hostnames/IPs with your actual infrastructure details
# Add appropriate host_vars and group_vars as needed
#
# WARNING: Never commit actual credentials or sensitive details!
# Use Vault for secret management instead.

[dbservers]
postgresql01.example.com
postgresql02.example.com

[vault]
vault01.example.com
vault02.example.com

[powerdns]
dns01.example.com
dns02.example.com

[powerdns-recurse]
resolver01.example.com

[domain_controllers_windows]
dc01.example.com
dc02.example.com

[rdp_member_servers_windows]
app01.example.com

[rdp_servers_windows:children]
domain_controllers_windows
rdp_member_servers_windows

[rdp_servers_windows:vars]
ansible_connection=winrm
ansible_port=5985
ansible_winrm_scheme=http
ansible_winrm_transport=ntlm
ansible_user=administrator@example.com

[proxmox_nodes]
pve01.example.com
pve02.example.com
pve03.example.com

[mcp_servers]
# Container that hosts the Proxmox MCP server. Created by
# ansible/proxmox/proxmox_mcp.yml; the address here must match
# proxmox_mcp_lxc_ipv4_cidr.
mcp0.example.com ansible_host=192.168.1.60 ansible_user=root

[mcp_servers:vars]
ansible_python_interpreter=/usr/bin/python3

[claude_workstation]
# Domain-joined container that hosts the Claude Code CLI, reached through
# Guacamole as an SSH connection. Created by
# ansible/proxmox/claude_workstation.yml; the address here must match
# claude_workstation_lxc_ipv4_cidr.
cwork0.example.com ansible_host=192.168.1.61 ansible_user=root

[claude_workstation:vars]
ansible_python_interpreter=/usr/bin/python3

[all:vars]
# Connection settings
ansible_user=admin
ansible_python_interpreter=/usr/bin/python3

# Vault configuration (update with your Vault server details)
vault_addr=https://vault.example.com:8200
vault_skip_verify=false

# Ceph cluster (if applicable)
ceph_cluster_name=ceph
